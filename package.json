{
  "name": "tachiyomi-ios-extensions",
  "private": true,
  "type": "module",
  "description": "Sources for tachiyomi-ios, ported from keiyoushi/extensions-source to TypeScript.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:sdk": "node --test \"sdk/test/**/*.test.mjs\"",
    "test": "npm run test:sdk && node scripts/test.mjs",
    "test:ext": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "css-select": "7.0.0",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "esbuild": "0.28.2",
    "parse5": "8.1.1",
    "parse5-htmlparser2-tree-adapter": "8.0.2",
    "typescript": "7.0.2"
  }
}

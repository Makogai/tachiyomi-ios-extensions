{
  "name": "tachiyomi-ios-extensions",
  "private": true,
  "type": "module",
  "description": "Sources for tachiyomi-ios, ported from keiyoushi/extensions-source to TypeScript.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run test:sdk && npm run test:unit && node scripts/test.mjs",
    "test:sdk": "node --test \"sdk/test/**/*.test.mjs\"",
    "test:unit": "node --test \"src/**/*.test.mjs\"",
    "test:ext": "node scripts/test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run typecheck && npm test && npm run validate",
    "new": "node scripts/new.mjs",
    "fixture": "node scripts/fixture.mjs",
    "debug": "node scripts/debug.mjs",
    "live": "node scripts/live.mjs",
    "status": "node scripts/status.mjs",
    "upstream": "node scripts/upstream.mjs",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "esbuild": "0.28.2",
    "parse5": "8.1.1",
    "parse5-htmlparser2-tree-adapter": "8.0.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
